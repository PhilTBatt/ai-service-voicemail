# CallMate environment variables: names and descriptions only, never real values.
# Copy this file to .env in the repo root and fill it in. .env is git-ignored.
# Empty values count as unset, so the defaults apply.

# development | test | production. Default: development.
NODE_ENV=

# Port the API listens on. Default: 3000.
PORT=

# error | warn | info | http | verbose | debug | silly. Default: info.
LOG_LEVEL=

# Required. How the API connects: as the restricted app role (callmate_app), so row-level
# security applies. Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Local values for both URLs are in docker-compose.yml.
DATABASE_URL=

# The cross-tenant admin role (callmate_admin): npm run db:seed and the worker's retention job.
ADMIN_DATABASE_URL=

# Used only by npm run db:migrate, never by the API: the owner role (callmate_owner).
# dbmate requires SSL by default; local Docker has none, so its URL ends ?sslmode=disable.
MIGRATION_DATABASE_URL=

# Retell AI API key, from dashboard.retellai.com. Optional in development (voice webhooks
# are disabled without it); required in production.
RETELL_API_KEY=
# Retell signs its webhooks with ONE specific key: the one marked "webhook" in Retell's
# dashboard (Settings > API keys). If RETELL_API_KEY isn't that key, put the badged key here.
RETELL_WEBHOOK_KEY=

# Twilio. Optional in development; required in production. The auth token is a secret:
# never paste it anywhere but here. Find both under Account > API keys & tokens.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The public HTTPS URL that reaches this API (the ngrok static domain locally, the Azure
# URL later). Twilio signs the exact URL it calls, so this must match it character for character.
PUBLIC_BASE_URL=

# Leave empty locally. On Azure, infra/main.bicep sets it once the API has its own domain: the
# other address the API answers at. Twilio's signatures for it are accepted too, and the
# dashboard opened there is sent on to DASHBOARD_ORIGIN.
ALTERNATE_BASE_URL=

# Buying numbers costs money. Leave false everywhere except where a live-* script runs.
TWILIO_PURCHASES_ENABLED=false

# UK numbers need an approved regulatory bundle and address (Twilio Console > Regulatory
# Compliance). Both are IDs, not secrets.
TWILIO_BUNDLE_SID=
TWILIO_ADDRESS_SID=

# The TwiML Bin URL that plays the static voicemail when the API can't be reached
# (paste the output of npm run twiml:fallback into a bin, then copy its URL here).
FALLBACK_VOICEMAIL_URL=

# Anthropic API key for post-call extraction (console.anthropic.com; set a monthly spend
# limit there). Optional in development; required in production.
ANTHROPIC_API_KEY=
# The extraction model, pinned. Default: claude-haiku-5-5 (the current small model).
LLM_MODEL=
# Share of processed calls whose summary the hallucination judge checks (0 = off, 1 = all).
# Each check is one more model call. Default: 0.
JUDGE_SAMPLE_RATE=

# Outside production, SMS and email go ONLY to these (comma-separated E.164 numbers and
# email addresses). Put your own mobile and email here for testing.
OUTBOUND_ALLOWLIST=

# The shared number notifications are sent from: a UK mobile in E.164 (UK local numbers
# can't send SMS), or an alphanumeric sender ID up to 11 characters (can't receive replies).
TWILIO_SMS_FROM=

# Signs the links to call pages in texts and emails (valid 7 days). At least 32 random
# characters; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=

# Email (decision 010: Postmark). The server token is a secret (Postmark > your server > API
# Tokens). EMAIL_FROM must be an address at a domain Postmark has verified for you. Optional in
# development (email jobs wait in the queue); required in production.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=
# Where replies go, if not EMAIL_FROM. Optional.
EMAIL_REPLY_TO=
# Where alerts are emailed (RUNBOOK section 11), at most one per alert per 15 minutes. Needs
# the email settings above. Outside production the address must also be in OUTBOUND_ALLOWLIST.
ALERT_EMAIL=

# Payments (decision 019: GoCardless Direct Debit). The access token is a secret: GoCardless
# dashboard > Developers > Create > Access token, read-write. A sandbox token
# (manage-sandbox.gocardless.com) only works with GOCARDLESS_ENVIRONMENT=sandbox, the default;
# a live one needs GOCARDLESS_ENVIRONMENT=live. Optional: without a token, billing is off.
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_ENVIRONMENT=sandbox
# The webhook endpoint's secret (Developers > Webhooks), once one points at this API. Without
# it, payment webhooks are refused.
GOCARDLESS_WEBHOOK_SECRET=

# VAT, once Brockersby is VAT registered: both or neither. The number (GB and 9 digits) goes
# on receipts; billing months that start on or after the date (YYYY-MM-DD) have 20% added.
VAT_REGISTRATION_NUMBER=
VAT_REGISTRATION_FROM=

# Postmark's bounce and spam-complaint webhook is protected by Basic auth in its URL. Make up
# a long random password, put it here, and register this URL at Postmark (server > Webhooks):
#   https://postmark:<that password>@<your public host>/webhooks/postmark
POSTMARK_WEBHOOK_SECRET=

# Dashboard login (decision 012: Clerk), from the Clerk Dashboard's API keys page. The secret
# key is shown in full only when you add it (Clerk changed this on 2026-10-19), so add a new one
# if you don't have it. The publishable key isn't secret: the dashboard's build embeds it.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Optional, not secret: Clerk's JWT public key (PEM), from the same API keys page. With it, the
# API checks login tokens without calling Clerk. In double quotes; on one line, write its line
# breaks as \n.
CLERK_JWT_KEY=
# The site the dashboard is served from. Login tokens made for any other site are refused.
# Leave empty locally (it defaults to the dev server, http://localhost:5173).
DASHBOARD_ORIGIN=

# Where the built dashboard is, for the API to serve it at /. Only the container image sets it
# (Dockerfile); leave it unset locally, where npm run dev:web serves the dashboard.
DASHBOARD_DIST=
