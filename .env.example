# CallMate environment variables: names and descriptions only, never real values.
# Copy this file to .env in the repo root and fill it in. .env is git-ignored.
# Empty values count as unset, so the defaults apply.

# development | test | production. Default: development.
NODE_ENV=

# Port the API listens on. Default: 3000.
PORT=

# error | warn | info | http | verbose | debug | silly. Default: info.
LOG_LEVEL=

# Required. How the API connects: as the restricted app role (callmate_app), so row-level
# security applies. Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Local values for both URLs are in docker-compose.yml.
DATABASE_URL=

# Used only by npm run db:seed: the cross-tenant admin role (callmate_admin).
ADMIN_DATABASE_URL=

# Used only by npm run db:migrate, never by the API: the owner role (callmate_owner).
# dbmate requires SSL by default; local Docker has none, so its URL ends ?sslmode=disable.
MIGRATION_DATABASE_URL=

# Retell AI API key, from dashboard.retellai.com. Optional in development (voice webhooks
# are disabled without it); required in production.
RETELL_API_KEY=
