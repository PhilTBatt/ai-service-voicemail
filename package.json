{
  "name": "callmate",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @callmate/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "dbmate --env MIGRATION_DATABASE_URL --migrations-dir apps/api/src/db/migrations --no-dump-schema up",
    "db:status": "dbmate --env MIGRATION_DATABASE_URL --migrations-dir apps/api/src/db/migrations status",
    "db:new": "dbmate --migrations-dir apps/api/src/db/migrations new",
    "db:seed": "node --env-file-if-exists=.env apps/api/src/db/seed.ts",
    "worker": "npm run worker --workspace @callmate/api",
    "demo:profile": "node --env-file-if-exists=.env apps/api/src/scripts/save-demo-profile.ts",
    "twiml:fallback": "node --env-file-if-exists=.env apps/api/src/scripts/print-fallback-twiml.ts",
    "live-buy-test-number": "node --env-file-if-exists=.env apps/api/src/scripts/live-buy-test-number.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "dbmate": "^2.37.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
